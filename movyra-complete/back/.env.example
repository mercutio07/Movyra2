# Movyra API — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# Clé API TMDB — gratuite sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=ta_clé_tmdb_ici

# Langue des résultats TMDB (fr-FR ou en-US)
TMDB_LANGUAGE=fr-FR

# Région pour les plateformes (FR, US, BE...)
TMDB_REGION=FR

# Clé Anthropic pour Claude API
ANTHROPIC_API_KEY=ta_clé_anthropic_ici

# Port du serveur (optionnel, défaut 3000)
PORT=3000
